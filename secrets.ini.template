[Email]
# mailkeys.py: Abrufen von KDMs
ImapHost = imap.my-cinema.de
SmtpHost = smtp.my-cinema.de
User     = dcp@my-cinema.de
Passwd   = secret_password
Basepath = /Base/path/to/store
# Email notification wenn neue Schlüssel gefunden wurden
Notify   = download@my-cinema.de
Sender   = robot@my-cinema.de

[Signal]
Account = <phone>
# Adressaten fuer "mailkeys"
KdmTarget  = <phone>
KdmTargetGroup = <groupID>
# Adressaten fuer "weischerplay"
WerbungTarget = <phone>
WerbungTargetGroup = <groupID>

[Disk]
# Disk watch
Features = /srv/path/Features
Trailers = /srv/path/Trailers
threshold = 80

[Screen]
# mailkeys: Prüfe dass der Schlüssel zum Screen passt
# A regex pattern that is matched against the <X509SubjectName>
pattern = IMB-123456

[Weischerplay]
# weischerplay.py Abrufen von Werbebuchungen
User   = xxxxxxx
Passwd = yyyyyyy
